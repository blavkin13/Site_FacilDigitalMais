{
  "name": "aprova-digital-apostilas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5173",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test --test-isolation=none tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern .next",

    "db:generate": "drizzle-kit generate",
    "db:init": "tsx db/init.ts",
    "db:migrate": "tsx db/init.ts",
    "db:seed": "tsx db/seed.ts",
    "db:seed-orders": "tsx db/seed-orders.ts",
    "db:seed-simulations": "tsx db/seed-simulations.ts",
    "db:load-products": "tsx scripts/load-products.ts",

    "test:phase0:build": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase0-build.test.mjs",
    "test:phase0:db": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase0.test.mjs",
    "test:phase0": "npm run test:phase0:build && npm run test:phase0:db",

    "test:phase1": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/auth.test.mjs",
    "test:phase2": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase2.test.mjs",
    "test:phase3": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase3.test.mjs",
    "test:phase3b": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase3b.test.mjs",
    "test:phase4": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase4.test.mjs",
    "test:phase5": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase5.test.mjs",
    "test:phase6": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase6.test.mjs",

    "test:phase1-products:repo": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase1-products.test.mjs",
    "test:phase1-products:cli": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase1-loader-cli.test.mjs",
    "test:phase1-products": "npm run test:phase1-products:repo && npm run test:phase1-products:cli",

    "test:phase2a-storefront": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase2a-storefront.test.mjs",
    "test:phase2b-product-page": "NODE_NO_WARNINGS=1 tsx --test --test-isolation=none --no-warnings tests/phase2b-product-page.test.mjs",

    "test:production-build": "rm -rf .next && next build",

    "test:all": "npm run test:phase0 && npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase3b && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase1-products && npm run test:phase2a-storefront && npm run test:phase2b-product-page && npm run test:production-build",

    "validate": "node scripts/validate-all.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "0.45.2",
    "mercadopago": "^3.4.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Aprova Digital — Apostilas para Concursos"
}