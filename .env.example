# ============================================================
# FACIL DIGITAL+
# Exemplo de variaveis de ambiente
# ============================================================
#
# Desenvolvimento:
#
#   cp .env.example .env.local
#
# Producao:
#
# Configure os valores diretamente no VPS ou em arquivo
# de ambiente protegido.
#
# NUNCA versione segredos reais.
# ============================================================


# ------------------------------------------------------------
# APLICACAO
# ------------------------------------------------------------

NODE_ENV=development

# Desenvolvimento.
# No VPS normalmente utilizaremos porta interna 3000,
# atrás do Nginx.
PORT=5173


# ------------------------------------------------------------
# BANCO DE DADOS
# ------------------------------------------------------------

DATABASE_PATH=./data/dev.db

# Exemplo para producao:
#
# DATABASE_PATH=/var/lib/facil-digital-plus/database/prod.db


# ------------------------------------------------------------
# UPLOADS ORIGINAIS
# ------------------------------------------------------------

# Armazenamento persistente dos arquivos enviados pelo admin.
#
# Estrutura criada automaticamente:
#
#   UPLOAD_ROOT_DIR/
#       covers/
#       pdfs/
#
# Os PDFs desta pasta NÃO são servidos diretamente ao público.
#
# Desenvolvimento:
UPLOAD_ROOT_DIR=./data/uploads

# Produção recomendada:
#
# UPLOAD_ROOT_DIR=/var/lib/facil-digital-plus/uploads


# ------------------------------------------------------------
# PDFs TEMPORARIOS PROTEGIDOS
# ------------------------------------------------------------

# PDFs personalizados gerados após a compra.
#
# Eles são diferentes dos originais armazenados em
# UPLOAD_ROOT_DIR/pdfs.

PROTECTED_PDF_DIR=./data/protected

# Produção:
#
# PROTECTED_PDF_DIR=/var/lib/facil-digital-plus/protected


# ------------------------------------------------------------
# MERCADO PAGO
# ------------------------------------------------------------

MERCADO_PAGO_ACCESS_TOKEN=

MERCADO_PAGO_WEBHOOK_SECRET=