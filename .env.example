# ============================================================
# FACIL DIGITAL+
# Exemplo de variaveis de ambiente
# ============================================================
#
# Nunca versione segredos reais.
#
# Desenvolvimento:
#
#   cp .env.example .env.local
#
# Producao:
#
#   use valores reais somente no ambiente protegido do VPS.
#
# ============================================================


# ------------------------------------------------------------
# APLICACAO
# ------------------------------------------------------------

NODE_ENV=development

# Desenvolvimento local / Codespaces:
PORT=5173

# Origem publica/canonica da aplicacao.
#
# Produção:
# APP_BASE_URL=https://facildigitalmais.com
#
APP_BASE_URL=http://localhost:5173

# Mantida para componentes que eventualmente precisem
# conhecer a URL publica no browser.
#
# Produção:
# NEXT_PUBLIC_BASE_URL=https://facildigitalmais.com
#
NEXT_PUBLIC_BASE_URL=http://localhost:5173


# ------------------------------------------------------------
# BANCO DE DADOS
# ------------------------------------------------------------

# Desenvolvimento:
DATABASE_PATH=./data/dev.db

# Produção recomendada:
#
# DATABASE_PATH=/var/lib/facil-digital-plus/database/prod.db


# ------------------------------------------------------------
# BACKUP DO SQLITE
# ------------------------------------------------------------

# Em desenvolvimento pode permanecer vazio.
# O fallback será data/backups.
#
DATABASE_BACKUP_DIR=

# Em produção utilize diretório absoluto e,
# preferencialmente, fora do diretório da aplicação:
#
# DATABASE_BACKUP_DIR=/var/backups/facil-digital-plus/sqlite

# Quantidade de backups locais mantidos.
DATABASE_BACKUP_RETENTION=14


# ------------------------------------------------------------
# UPLOADS ORIGINAIS
# ------------------------------------------------------------

# Armazenamento persistente dos arquivos enviados pelo admin.
#
# Estrutura criada automaticamente:
#
#   UPLOAD_ROOT_DIR/
#       covers/
#       pdfs/
#
# PDFs originais não devem ser servidos diretamente ao público.

# Desenvolvimento:
UPLOAD_ROOT_DIR=./data/uploads

# Produção:
#
# UPLOAD_ROOT_DIR=/var/lib/facil-digital-plus/uploads


# ------------------------------------------------------------
# PDFs TEMPORARIOS PROTEGIDOS
# ------------------------------------------------------------

# Desenvolvimento:
#
# Deixe vazio para utilizar automaticamente:
#
#   data/protected
#
PROTECTED_PDF_DIR=

# Produção exige caminho absoluto:
#
# PROTECTED_PDF_DIR=/var/lib/facil-digital-plus/protected


# ------------------------------------------------------------
# ADMINISTRADOR INICIAL
# ------------------------------------------------------------

ADMIN_SEED_EMAIL=digicopiamix@facildigitalmais.com
ADMIN_SEED_NAME=Administrador Sistema

# Nunca grave a senha aqui.
#
# Utilize a variável somente no ambiente de execução quando
# precisar criar ou rotacionar a credencial administrativa.
#
ADMIN_SEED_PASSWORD=


# ------------------------------------------------------------
# MERCADO PAGO
# ------------------------------------------------------------

MERCADO_PAGO_ACCESS_TOKEN=

MERCADO_PAGO_WEBHOOK_SECRET=