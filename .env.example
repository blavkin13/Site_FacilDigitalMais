# ============================================================
# FACIL DIGITAL+
# EXEMPLO DE VARIAVEIS DE AMBIENTE
# ============================================================
#
# Nunca coloque senhas, tokens ou segredos reais neste arquivo.
#
# Desenvolvimento:
#
#   cp .env.example .env.local
#
# Producao:
#
#   configure os valores reais diretamente na VPS
#   ou em um arquivo de ambiente protegido.
#
# ============================================================


# ------------------------------------------------------------
# APLICACAO
# ------------------------------------------------------------

NODE_ENV=development

# O desenvolvimento utiliza 5173.
# Na Hostinger/PM2 utilizaremos normalmente 3000.
PORT=5173


# ------------------------------------------------------------
# URL PUBLICA
# ------------------------------------------------------------

# Utilizada por sitemap, SEO, callbacks e URLs absolutas.
#
# Desenvolvimento:
NEXT_PUBLIC_BASE_URL=http://localhost:5173

# Exemplo em producao:
# NEXT_PUBLIC_BASE_URL=https://seudominio.com.br


# ------------------------------------------------------------
# SQLITE
# ------------------------------------------------------------

# Caminho relativo:
#
# O nome informado será armazenado dentro de:
#
#   ./data/
#
DATABASE_PATH=dev.db

# Também são aceitos:
#
# DATABASE_PATH=data/dev.db
# DATABASE_PATH=./data/dev.db

# Em produção também é permitido caminho absoluto:
#
# DATABASE_PATH=/var/www/facil-digital-plus/data/prod.db


# ------------------------------------------------------------
# MERCADO PAGO
# ------------------------------------------------------------

# Access Token da aplicação Mercado Pago.
MERCADO_PAGO_ACCESS_TOKEN=

# Secret de validação dos webhooks Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=