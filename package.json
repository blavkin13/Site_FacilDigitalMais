{
  "name": "aprova-digital-apostilas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:init": "npx tsx db/init.ts",
    "db:seed": "npx tsx db/seed.ts",
    "test:phase1": "npx tsx --test tests/auth.test.mjs",
    "test:phase2": "npx tsx --test tests/phase2.test.mjs",
    "db:seed-orders": "npx tsx db/seed-orders.ts",
    "test:phase3": "npx tsx --test tests/phase3.test.mjs",
    "db:seed-simulations": "npx tsx db/seed-simulations.ts",
    "test:phase3b": "npx tsx --test tests/phase3b.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Aprova Digital — Apostilas para Concursos"
}
