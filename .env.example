# ============================================================
# FACIL DIGITAL+
# Exemplo de variaveis de ambiente
# ============================================================
#
# INSTRUCOES:
#
# Desenvolvimento:
#   cp .env.example .env.local
#
# Producao:
#   configure as variaveis reais diretamente no servidor/VPS
#   ou em um arquivo .env.production protegido.
#
# NUNCA coloque senhas, tokens ou segredos reais neste arquivo.
# O .env.example e versionado no Git apenas como referencia.
# ============================================================


# ------------------------------------------------------------
# APLICACAO
# ------------------------------------------------------------

# Ambiente Node.
# Valores usuais:
# development
# production
NODE_ENV=development

# Porta utilizada pela aplicacao.
#
# O script "npm run dev" utiliza atualmente a porta 5173.
# Na Hostinger/PM2 a aplicacao sera executada normalmente
# na porta 3000, atras do Nginx.
PORT=5173


# ------------------------------------------------------------
# BANCO DE DADOS
# ------------------------------------------------------------

# Caminho do arquivo SQLite.
#
# Desenvolvimento:
DATABASE_PATH=./data/dev.db

# Exemplo futuro para producao:
# DATABASE_PATH=/var/www/facil-digital-plus/data/prod.db


# ------------------------------------------------------------
# MERCADO PAGO
# ------------------------------------------------------------

# Access Token fornecido pelo Mercado Pago.
#
# Em desenvolvimento pode permanecer vazio enquanto estivermos
# utilizando o comportamento de teste/demo existente.
#
# Em producao este valor devera ser obrigatoriamente configurado.
MERCADO_PAGO_ACCESS_TOKEN=

# Secret utilizado para validar a assinatura dos webhooks
# enviados pelo Mercado Pago.
#
# Em producao este valor devera ser obrigatoriamente configurado.
MERCADO_PAGO_WEBHOOK_SECRET=